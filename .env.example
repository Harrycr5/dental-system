# Copiar a .env y ajustar. NUNCA subir .env al repositorio.
ENVIRONMENT=development          # development | testing | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
TIMEZONE=America/Lima
# Lista JSON de orígenes permitidos para CORS
CORS_ORIGINS=["http://localhost:3000"]

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-use-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# PostgreSQL local (FastAPI en el host). Los contenedores Celery sobrescriben
# DB_HOST con host.docker.internal desde docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dental
DB_USER=dental_app
DB_PASSWORD=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Redis (publicado solo en 127.0.0.1). Los contenedores usan REDIS_HOST=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me-redis-password
CELERY_BROKER_DB=1
CELERY_RESULT_BACKEND_ENABLED=false
CELERY_TASK_SOFT_TIME_LIMIT=60
CELERY_TASK_TIME_LIMIT=90
